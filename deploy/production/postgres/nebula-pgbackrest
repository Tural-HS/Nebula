#!/usr/bin/env bash
# pgBackRest with repository credentials loaded from Docker secret files for this invocation only.
# Used by archive_command, scripts/backup.sh, restore.sh and restore-test.sh. The credentials are
# never in the image, a config file, the command line, or the postmaster's environment.
set -euo pipefail

load_secret() { # load_secret VAR secret-name
	local file=/run/secrets/$2
	[[ -r $file ]] || { echo "nebula-pgbackrest: missing secret $file" >&2; exit 1; }
	printf -v "$1" '%s' "$(tr -d '\r\n' <"$file")"
	export "${1?}"
}

load_secret PGBACKREST_REPO1_S3_KEY pgbackrest_s3_key
load_secret PGBACKREST_REPO1_S3_KEY_SECRET pgbackrest_s3_key_secret
load_secret PGBACKREST_REPO1_CIPHER_PASS pgbackrest_cipher_pass

# Optional second repository (compose.repo2-offsite.yaml: migration from the same-host pilot target
# to off-site S3, README "Pulsuz yerel backup (pilot)"). Same encryption passphrase as repo1, so the
# repository can later become repo1 unchanged.
if [[ -e /run/secrets/pgbackrest_repo2_s3_key ]]; then
	load_secret PGBACKREST_REPO2_S3_KEY pgbackrest_repo2_s3_key
	load_secret PGBACKREST_REPO2_S3_KEY_SECRET pgbackrest_repo2_s3_key_secret
	load_secret PGBACKREST_REPO2_CIPHER_PASS pgbackrest_cipher_pass
fi

exec pgbackrest "$@"
