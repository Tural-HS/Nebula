<!doctype html>
<html lang="{{.Lang}}">
<head>
<meta charset="utf-8">
<meta http-equiv="Content-Security-Policy" content="default-src 'none'; style-src 'unsafe-inline'">
<meta name="viewport" content="width=device-width, initial-scale=1">
<title>{{.L.Title}} · {{.M.Workspace.Name}}</title>
<style>
body{font:13px/1.45 system-ui,-apple-system,"Segoe UI",Roboto,"Noto Sans",Arial,sans-serif;color:#18181b;margin:24px;max-width:1100px}
h1{font-size:20px;margin:0 0 12px}h2{font-size:16px;margin:28px 0 8px;border-bottom:1px solid #d4d4d8;padding-bottom:4px}
h3{font-size:13px;margin:14px 0 4px;color:#3f3f46}
table{border-collapse:collapse;width:100%;margin:4px 0 8px}th,td{border:1px solid #e4e4e7;padding:4px 6px;text-align:left;vertical-align:top}
th{background:#f4f4f5;font-weight:600}.meta th{width:240px}.mono{font-family:ui-monospace,Menlo,Consolas,monospace;font-size:11px;word-break:break-all}
.pre{white-space:pre-wrap}.muted{color:#71717a}.note{background:#f4f4f5;padding:8px 10px;border-radius:4px}
.item{border:1px solid #d4d4d8;border-radius:6px;padding:10px 14px;margin:14px 0;page-break-inside:avoid}
ul{margin:2px 0;padding-left:18px}
@media print{body{margin:0;max-width:none}.item{page-break-inside:auto}a{color:inherit}}
</style>
</head>
<body>
<h1>{{.L.Title}}</h1>
<table class="meta">{{range .Header}}<tr><th>{{.K}}</th><td>{{.V}}</td></tr>{{end}}</table>
<p class="note">{{.L.VerifyNote}}</p>

<h2>{{.L.Summary}}</h2>
<table class="meta">{{range .Counts}}<tr><th>{{.K}}</th><td>{{.V}}</td></tr>{{end}}</table>

{{$L := .L}}
{{range .Items}}
<div class="item">
<h2>{{.Key}} · {{.Title}}</h2>
<table class="meta">
<tr><th>{{$L.Project}}</th><td>{{.Project}}</td></tr>
<tr><th>{{$L.Type}}</th><td>{{.Type}}</td></tr>
<tr><th>{{$L.Status}}</th><td>{{.Status}}</td></tr>
<tr><th>{{$L.Assignee}}</th><td>{{.Assignee}}</td></tr>
<tr><th>{{$L.Reporter}}</th><td>{{.Reporter}}</td></tr>
<tr><th>{{$L.Created}}</th><td>{{.Created}}</td></tr>
<tr><th>{{$L.Updated}}</th><td>{{.Updated}}</td></tr>
{{if .Due}}<tr><th>{{$L.Due}}</th><td>{{.Due}}</td></tr>{{end}}
{{if .Deleted}}<tr><th>{{$L.Deleted}}</th><td>{{.Deleted}}</td></tr>{{end}}
{{range .Fields}}<tr><th>{{$L.Fields}}: {{.K}}</th><td>{{.V}}</td></tr>{{end}}
</table>
{{if .Description}}<h3>{{$L.Description}}</h3><div class="pre">{{.Description}}</div>{{end}}

{{if .Approvals}}<h3>{{$L.Approvals}}</h3>
<table><tr><th>{{$L.Requested}}</th><th>{{$L.By}}</th><th>{{$L.Transition}}</th><th>{{$L.State}}</th><th>{{$L.Required}}</th><th>{{$L.Decisions}}</th></tr>
{{range .Approvals}}<tr><td>{{.Requested}}</td><td>{{.By}}{{if .Comment}}<div class="pre muted">{{.Comment}}</div>{{end}}</td><td>{{.Transition}}</td>
<td>{{.State}}{{if .Closed}}<div class="muted">{{.Closed}}</div>{{end}}</td><td>{{.Required}}</td>
<td><ul>{{range .Decisions}}<li>{{.Time}} · {{.Who}} {{.Verb}}{{if .Comment}}: <span class="pre">{{.Comment}}</span>{{end}}</li>{{end}}</ul></td></tr>{{end}}
</table>{{end}}

{{if .Comments}}<h3>{{$L.Comments}}</h3>
<table><tr><th>{{$L.Time}}</th><th>{{$L.Who}}</th><th>{{$L.Comments}}</th></tr>
{{range .Comments}}<tr><td>{{.Time}}{{if .Edited}}<div class="muted">{{$L.Edited}}</div>{{end}}</td><td>{{.Who}}</td><td class="pre">{{if .Deleted}}<span class="muted">{{$L.CommentDeleted}}</span>{{else}}{{.Body}}{{end}}</td></tr>{{end}}
</table>{{end}}

{{if .Links}}<h3>{{$L.Links}}</h3><ul>{{range .Links}}<li>{{.}}</li>{{end}}</ul>{{end}}

{{if .Attachments}}<h3>{{$L.Attachments}}</h3>
<table><tr><th>{{$L.File}}</th><th>{{$L.Size}}</th><th>{{$L.SHA256}}</th><th>{{$L.Uploader}}</th><th>{{$L.Time}}</th></tr>
{{range .Attachments}}<tr><td>{{.Name}}</td><td>{{.Size}}</td><td class="mono">{{.SHA256}}</td><td>{{.Uploader}}</td><td>{{.Time}}</td></tr>{{end}}
</table>{{end}}

{{if .History}}<h3>{{$L.History}}</h3>
<table><tr><th>#</th><th>{{$L.Time}}</th><th>{{$L.Who}}</th><th>{{$L.Action}}</th><th>{{$L.Details}}</th></tr>
{{range .History}}<tr><td class="mono">{{.ID}}</td><td>{{.Time}}</td><td>{{.Who}}</td><td class="mono">{{.Action}}</td><td><ul>{{range .Details}}<li class="pre">{{.}}</li>{{end}}</ul></td></tr>{{end}}
</table>{{end}}
</div>
{{end}}

{{if .ProjectEvents}}<h2>{{.L.ProjectEvents}}</h2>
<table><tr><th>#</th><th>{{.L.Time}}</th><th>{{.L.Who}}</th><th>{{.L.Action}}</th><th>{{.L.Details}}</th></tr>
{{range .ProjectEvents}}<tr><td class="mono">{{.ID}}</td><td>{{.Time}}</td><td>{{.Who}}</td><td class="mono">{{.Action}}</td><td><ul>{{range .Details}}<li class="pre">{{.}}</li>{{end}}</ul></td></tr>{{end}}
</table>{{end}}
</body>
</html>
