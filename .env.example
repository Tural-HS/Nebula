# Copy to .env for local overrides. Never commit real credentials.
NEBULA_ENV=development
NEBULA_HTTP_ADDR=:8080
NEBULA_ADMIN_ADDR=:9090
NEBULA_DATABASE_URL=postgres://nebula:nebula-dev-only@localhost:5432/nebula?sslmode=disable
NEBULA_DB_MAX_CONNS=20
NEBULA_LOG_LEVEL=info
NEBULA_LOG_FORMAT=text
NEBULA_SHUTDOWN_TIMEOUT=25s
NEBULA_REQUEST_TIMEOUT=30s
NEBULA_OIDC_ISSUER=http://localhost:8081/realms/nebula
NEBULA_OIDC_AUDIENCE=nebula-api
NEBULA_OIDC_JWKS_URL=http://localhost:8081/realms/nebula/protocol/openid-connect/certs
# Per replica; 0 disables. Behind a reverse proxy enforce per-IP limits at the ingress.
NEBULA_RATE_LIMIT_USER_RPS=20
NEBULA_RATE_LIMIT_USER_BURST=40
NEBULA_RATE_LIMIT_IP_RPS=100
NEBULA_RATE_LIMIT_IP_BURST=200
# Required for serve/worker: 32 random bytes, base64 (openssl rand -base64 32). Keep it in a secret store.
NEBULA_ENCRYPTION_KEY=
# Optional: empty host disables email. Production requires starttls or tls.
NEBULA_SMTP_HOST=
NEBULA_SMTP_PORT=587
NEBULA_SMTP_USERNAME=
NEBULA_SMTP_PASSWORD=
NEBULA_SMTP_FROM=Nebula <noreply@example.com>
NEBULA_SMTP_TLS=starttls
# Never true in production (SSRF). Dev only, for local webhook receivers.
NEBULA_WEBHOOK_ALLOW_PRIVATE=false
# Background jobs per process; 0 disables the worker in `serve` (run `nebula worker` separately).
NEBULA_WORKER_CONCURRENCY=4

# File attachments (ADR-0022). local = a persistent directory/volume (NOT covered by pgBackRest).
NEBULA_ATTACHMENTS_BACKEND=local
NEBULA_ATTACHMENTS_DIR=.data/attachments
# NEBULA_ATTACHMENTS_MAX_FILE_MB=20
# NEBULA_ATTACHMENTS_WORKSPACE_QUOTA_MB=5120
# s3 backend: keys as files in production (NEBULA_ATTACHMENTS_S3_ACCESS_KEY_FILE / _SECRET_KEY_FILE).
# NEBULA_ATTACHMENTS_S3_ENDPOINT=https://s3.example.test
# NEBULA_ATTACHMENTS_S3_BUCKET=
